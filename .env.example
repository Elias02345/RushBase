# Rushbase configuration template. Copy to .env and fill in; .env is never committed.
# The installer (milestone M7) generates the secrets below on first run and preserves existing
# values on re-runs. Do NOT use the placeholders as real values.

# --- Required (the server refuses to start without them) ---

# Master secret for signing and encryption, at least 32 characters.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
RUSHBASE_SECRET_KEY=

# SQLAlchemy URL of the PostgreSQL database (psycopg 3 driver).
# Example shape: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
RUSHBASE_DATABASE_URL=

# --- Server ---

# Bind address. Keep 127.0.0.1 behind a reverse proxy or tunnel; use 0.0.0.0 inside containers.
RUSHBASE_HOST=127.0.0.1
# TCP port.
RUSHBASE_PORT=8080
# DEBUG, INFO, WARNING or ERROR. Logs are JSON lines on stderr.
RUSHBASE_LOG_LEVEL=INFO
# Local mount point of the media library (contains Input/, Content/, .rushbase/).
RUSHBASE_LIBRARY_ROOT=

# --- Server lease (one coordinator per library, stored in .rushbase/library.json) ---

# Identifier of this server instance; generated per process when empty.
RUSHBASE_HOLDER_ID=
# Take over the library even if another server's lease is still valid (same as --force-takeover).
# Use only after making sure the other server is stopped.
RUSHBASE_FORCE_TAKEOVER=false
# Lease length and renewal interval in seconds.
RUSHBASE_SERVER_LEASE_SECONDS=120
RUSHBASE_SERVER_LEASE_HEARTBEAT_SECONDS=30

# --- Input scanner and pipeline ---

# Run the background loops (lease heartbeat, scanner, queue maintenance, backups).
RUSHBASE_BACKGROUND_TASKS=true
# Seconds between scans of Input/ (inotify is unreliable on SMB).
RUSHBASE_SCAN_INTERVAL_SECONDS=60
# A file is stable when unchanged in this many scans AND for this many seconds.
RUSHBASE_STABLE_SCANS=2
RUSHBASE_STABLE_SECONDS=120
# Seconds between queue maintenance passes (lease reaper, server-side stages).
RUSHBASE_MAINTENANCE_INTERVAL_SECONDS=15
# Stages created for new assets, comma separated (finalize is always added). The AI stages
# audio, embed, vision and classify arrive with milestone M4.
RUSHBASE_PIPELINE_STAGES=probe,hash,preview,shots,finalize
# Stages the server runs itself for setups without any worker (default: none). Supported: hash.
RUSHBASE_INPROCESS_STAGES=

# --- Search (CPU query encoding, see docs/search.md) ---

# Directory with the worker's model store (<models_dir>/<model-id>/<file>); empty = full-text only.
RUSHBASE_MODELS_DIR=
# Override the pinned ids / revisions stored vectors must match (defaults follow worker/models.lock.json).
RUSHBASE_SIGLIP_MODEL_ID=siglip2-base-patch16-256
RUSHBASE_SIGLIP_REVISION=
RUSHBASE_E5_MODEL_ID=multilingual-e5-base
RUSHBASE_E5_REVISION=
RUSHBASE_ENCODER_THREADS=2

# --- Job queue ---

# Seconds a worker holds a job without heartbeat, and how often it should heartbeat.
RUSHBASE_JOB_LEASE_SECONDS=120
RUSHBASE_JOB_HEARTBEAT_SECONDS=30
# Attempts before a job fails and its asset is quarantined.
RUSHBASE_JOB_MAX_ATTEMPTS=5
# Retry delay after failed attempt n: min(base * 2^(n-1), cap) seconds.
RUSHBASE_JOB_BACKOFF_BASE_SECONDS=30
RUSHBASE_JOB_BACKOFF_CAP_SECONDS=3600
# A worker counts as online when seen within this many seconds.
RUSHBASE_WORKER_ONLINE_SECONDS=90

# --- Authentication ---

# Send session cookies only over HTTPS. Enable behind a TLS-terminating proxy or tunnel.
RUSHBASE_COOKIE_SECURE=false
RUSHBASE_SESSION_TTL_HOURS=168
# Failed logins per client address / user name before 429, within the window (seconds).
RUSHBASE_LOGIN_MAX_FAILURES=5
RUSHBASE_LOGIN_WINDOW_SECONDS=900
# Lifetime of one-time worker enrollment tokens.
RUSHBASE_ENROLLMENT_TTL_HOURS=24

# --- Filing ---

# Characters available for the library-relative path of the longest file (Windows-safe roots < 240).
RUSHBASE_FILING_PATH_BUDGET=180

# --- Backups (written to <library>/.rushbase/backups/) ---

RUSHBASE_BACKUP_ENABLED=true
RUSHBASE_BACKUP_INTERVAL_HOURS=6
# Number of "interval" and "daily" backups to keep.
RUSHBASE_BACKUP_KEEP_INTERVAL=8
RUSHBASE_BACKUP_KEEP_DAILY=14
# pg_dump / pg_restore binaries (default: found on PATH; the server image contains them).
RUSHBASE_PG_DUMP=
RUSHBASE_PG_RESTORE=
# Development fallback when no PostgreSQL client is installed: run the tools via docker exec
# in this container, e.g. rushbase-dev-postgres-1.
RUSHBASE_PG_DOCKER_CONTAINER=

# --- Operations ---

# Expose Prometheus metrics at /metrics (unauthenticated: keep the port private).
RUSHBASE_METRICS_ENABLED=false

# --- Worker / CLI (rushbase command) ---

# Same library root as seen from the worker machine.
# RUSHBASE_LIBRARY_ROOT is shared with the server setting above.
# Library id the mount must match (from .rushbase/library.json); optional safety check.
RUSHBASE_LIBRARY_ID=
# Base URL of the Rushbase server for `rushbase doctor` and workers.
RUSHBASE_SERVER_URL=

# --- Development and tests only ---

# PostgreSQL URL used by the server test suite (tests needing a database are skipped without it).
# `make dev-up` generates dev/data/dev.env with working values.
RUSHBASE_TEST_DATABASE_URL=

# --- Operations (written by install.sh; see docs/operations.md) ---

# Host-side bind address and port of the published server (Docker mode) / the unix service.
RUSHBASE_BIND=127.0.0.1
# Docker mode only: PostgreSQL password for the compose stack (generated by install.sh).
RUSHBASE_DB_PASSWORD=
# Docker mode only: host path of the media library, mounted at /library in the container.
RUSHBASE_LIBRARY_HOST_PATH=
# Docker host-network mode only: PostgreSQL port on 127.0.0.1.
RUSHBASE_DB_PORT=15432
# true = the updater applies updates automatically; false = only record availability.
RUSHBASE_UPDATE_AUTO=false
# Poll interval of the update check (systemd time span). Re-render units after changing it:
# sudo bash install.sh --units-only
RUSHBASE_UPDATE_INTERVAL=10min
# true = refuse updates whose commit has no valid SSH signature from deploy/allowed_signers.
RUSHBASE_UPDATE_REQUIRE_SIGNED=false
# Consecutive failed health checks (one per minute) before the watchdog restarts the service.
RUSHBASE_WATCHDOG_THRESHOLD=3
# Number of update backups to keep in /var/lib/rushbase/backups.
RUSHBASE_BACKUP_KEEP=10
# Optional: executable called with the backup directory after each backup (for example to
# upload it). A hook that fails or exceeds 300 s only logs a warning.
# RUSHBASE_BACKUP_HOOK=

# --- Worker (rushbase-worker; see docs/worker.md) ---
# Local mount of the library root and where the worker keeps its API key and state.
# RUSHBASE_SERVER_URL=http://127.0.0.1:8080
# RUSHBASE_DATA_DIR=/var/lib/rushbase-worker
# RUSHBASE_CONCURRENCY=2
# RUSHBASE_STAGES=["probe","hash","preview","shots"]
# AI stages (docs/worker-ai.md): RUSHBASE_AUTO_DOWNLOAD=false, RUSHBASE_PROFILE=gpu8,
# RUSHBASE_VISION_VARIANT=gpu8-9b, RUSHBASE_EVENT_THRESHOLDS={"gunshot":0.5}
# RUSHBASE_PROXY_ENABLED=true
# RUSHBASE_FFMPEG_HWACCEL=false
# Personal API token for `rushbase status`, `search`, `browse`, `asset get` and `select`
# (`rushbase login` stores one in the data directory instead).
# RUSHBASE_API_TOKEN=
# DaVinci Resolve bridge (companion): defaults are Resolve's own ResolvePython (21.1+) and the
# per-OS scripting paths; set these for older versions or a custom install.
# RUSHBASE_RESOLVE_PYTHON=/opt/resolve/bin/ResolvePython
# RUSHBASE_RESOLVE_SCRIPT_API=/opt/resolve/Developer/Scripting
# RUSHBASE_RESOLVE_SCRIPT_LIB=/opt/resolve/libs/Fusion/fusionscript.so
