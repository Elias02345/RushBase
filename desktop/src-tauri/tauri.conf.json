{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rushbase",
  "version": "0.1.0",
  "identifier": "app.rushbase.companion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:15177",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Rushbase",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "category": "Video",
    "shortDescription": "Rushbase companion: local AI processing and library browsing",
    "longDescription": "Processes new footage on your own GPU PC and browses the Rushbase library with local originals.",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/rushbase"],
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"],
        "desktopTemplate": "rushbase.desktop",
        "files": {
          "/usr/share/icons/hicolor/32x32/apps/rushbase.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/64x64/apps/rushbase.png": "icons/64x64.png",
          "/usr/share/icons/hicolor/128x128/apps/rushbase.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/rushbase.png": "icons/256x256.png",
          "/usr/share/icons/hicolor/512x512/apps/rushbase.png": "icons/512x512.png",
          "/usr/share/icons/hicolor/scalable/apps/rushbase.svg": "icons/icon.svg"
        }
      },
      "rpm": {
        "desktopTemplate": "rushbase.desktop",
        "files": {
          "/usr/share/icons/hicolor/32x32/apps/rushbase.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/64x64/apps/rushbase.png": "icons/64x64.png",
          "/usr/share/icons/hicolor/128x128/apps/rushbase.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/rushbase.png": "icons/256x256.png",
          "/usr/share/icons/hicolor/512x512/apps/rushbase.png": "icons/512x512.png",
          "/usr/share/icons/hicolor/scalable/apps/rushbase.svg": "icons/icon.svg"
        }
      },
      "appimage": { "bundleMediaFramework": false }
    },
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "PLACEHOLDER-run-tauri-signer-generate-and-see-docs-companion.md",
      "endpoints": ["https://github.com/Elias02345/Rushbase/releases/latest/download/latest.json"]
    }
  }
}
