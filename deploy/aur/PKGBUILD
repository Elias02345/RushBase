# Maintainer: Rushbase contributors
# Repackages the official .deb of a release (it carries the desktop entry and hicolor icons) for
# Arch-based distributions. CI builds this on every release tag and attaches the resulting
# rushbase-bin-<ver>-1-x86_64.pkg.tar.zst to the GitHub release (sudo pacman -U <url>).
# By hand after a release: bump pkgver, run `updpkgsums`, `makepkg -si` (or push to the AUR).
# A pre-release version uses '_' here (0.9.0_rc.1) and maps back to '-' for the download URL.
pkgname=rushbase-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Rushbase companion: process footage on your own GPU and browse the library with local originals"
arch=('x86_64')
url="https://github.com/Elias02345/RushBase"
license=('Apache-2.0')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'ffmpeg')
optdepends=(
  'libayatana-appindicator: tray icon'
  'nvidia-utils: GPU temperature and power readout (nvidia-smi)'
  'davinci-resolve-studio: "Send to Resolve" (Studio edition only)'
  'xprintidle: "only while idle" on X11'
)
provides=('rushbase')
conflicts=('rushbase')
options=('!strip' '!debug')
_tagver="${pkgver//_/-}"
_deb="Rushbase_${_tagver}_amd64.deb"
source=("${_deb}::${url}/releases/download/v${_tagver}/${_deb}")
noextract=("${_deb}")
sha256sums=('SKIP')

package() {
  # data.tar.* holds /usr/bin/rushbase{,-desktop}, the .desktop entry and the hicolor icons.
  bsdtar -xf "${srcdir}/${_deb}" -C "${srcdir}" 'data.tar.*'
  bsdtar -xf "${srcdir}"/data.tar.* -C "${pkgdir}"
}
