# Nginx reverse proxy for Rushbase. Copy to /etc/nginx/sites-available/rushbase.conf, replace
# the host name and certificate paths (for example from certbot), then enable the site.
#
# Rushbase listens on 127.0.0.1:8080 (RUSHBASE_PORT). Do not expose that port directly.
#
# MCP (claude.ai connector): /mcp, /.well-known/* and /oauth/* must reach the server without any
# bot challenge, WAF rule or extra authentication layer in front of them.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name rushbase.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name rushbase.example.com;

    ssl_certificate     /etc/letsencrypt/live/rushbase.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rushbase.example.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Previews and uploads are small, but sidecar/derived transfers can be larger.
    client_max_body_size 256m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Streaming responses (MCP over HTTP, live job progress) must not be buffered.
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
